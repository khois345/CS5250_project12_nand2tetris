// File name: projects/12/Screen.jack
/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 512 rows (indexed 0..511, top to bottom)
 * of 256 pixels each (indexed 0..255, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */

 // Reference: https://github.com/zhixiangli/nand2tetris/blob/main/projects/12/Screen.jack
class Screen {
    static Array screen;
    static boolean currColor;

    /** Initializes the Screen. */
    function void init() {
        let screen = 16384;
        let currColor = true;
        return;
    }

    /** Erases the entire screen. */
    function void clearScreen() {
        var int i;
        let i = 0;

        // Set all memory words to 0 (white)
        while (i < 8192) { // 8192 words in the screen memory (512 * 256 / 16)
            let screen[i] = 0;
            let i = i + 1;
        }
        return;
    }

    /** Sets the current color, to be used for all subsequent drawXXX commands.
     *  Black is represented by true, white by false. */
    function void setColor(boolean b) {
        let currColor = b;
        return;
    }

    /** Draws the (x,y) pixel, using the current color. */
    function void drawPixel(int x, int y) {
        var int address, position, pow2, i;
        let address = (32 * y) + (x / 16);
        let position = x - (x / 16 * 16);
        let pow2 = 1;
        let i = 0;

        while (i < position) {
            let pow2 = pow2 * 2;
            let i = i + 1;
        }

        if (currColor) {
            let screen[address] = screen[address] | pow2;
        } else {
            let screen[address] = screen[address] & (~pow2);
        }
    }

    /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int a, b, dy;
        var int temp;

        // Swap points if x1 > x2 to ensure left-to-right drawing
        if (x1 > x2) {
            let temp = x1;
            let x1 = x2;
            let x2 = temp;
            let temp = y1;
            let y1 = y2;
            let y2 = temp;
        }

        // Determine the vertical direction of the line
        if (y1 < y2) {
            let dy = 1;
        } else {
            let dy = -1;
        }

        let a = 0; // Horizontal offset
        let b = 0; // Vertical offset

        // Loop until the line is fully drawn
        while (~((x1 + a = x2) & (y1 + b = y2))) {
            do drawPixel(x1 + a, y1 + b); // Draw the current pixel

            // If x1 + a reaches x2, adjust vertical offset
            if (x1 + a = x2) {
                let b = b + dy;
            } else {
                // If y1 + b reaches y2, adjust horizontal offset
                if (y1 + b = y2) {
                    let a = a + 1;
                } else {
                    // Calculate slope comparison to decide next step
                    let temp = ((y2 - y1) * (x2 - x1 - a)) - ((y2 - y1 - b) * (x2 - x1));
                    if (y1 < y2) {
                        if (temp < 0) {
                            let b = b + dy;
                        } else {
                            let a = a + 1;
                        }
                    } else {
                        if (temp < 0) {
                            let a = a + 1;
                        } else {
                            let b = b + dy;
                        }
                    }
                }
            }
        }
        return;
    }

    /** Draws a filled rectangle whose top left corner is (x1, y1)
     *  and bottom right corner is (x2,y2), using the current color. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        while (x1 <= x2) {
            do Screen.drawLine(x1, y1, x1, y2);
            let x1 = x1 + 1;
        }
        return;
    }

    /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
    function void drawCircle(int x, int y, int r) {
        var int dx, dy;
        let dy = -r;
        while (~(dy > r)) {
            let dx = Math.sqrt((r * r) - (dy * dy));
            do Screen.drawLine(x - dx, y + dy, x + dx, y + dy);
            let dy = dy + 1;
        }
        return;
    }
}
